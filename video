                <div 
                  onClick={() => fileInputRef.current?.click()}
                  className="border-2 border-dashed border-slate-700 hover:border-indigo-500 rounded-xl p-6 flex flex-col items-center justify-center bg-slate-950/50 transition cursor-pointer group mb-4"
                >
                  <div className="w-12 h-12 rounded-full bg-slate-800 group-hover:bg-indigo-600/20 text-slate-400 group-hover:text-indigo-400 flex items-center justify-center mb-2 transition">
                    <Upload className="w-6 h-6" />
                  </div>
                  <p className="text-xs font-semibold text-slate-300">
                    {customImage ? 'Foto Terunggah (Klik untuk Ganti)' : 'Klik untuk Unggah Baju / Produk Anda'}
                  </p>
                  <p className="text-[10px] text-slate-500 mt-0.5">Mendukung Format PNG, JPG (Atas Baju, Gaun, Celana)</p>
                </div>

                <p className="text-xs font-medium text-slate-400 mb-2">Atau Pilih Preset Busana:</p>
                <div className="grid grid-cols-3 gap-3">
                  {apparels.map((item) => (
                    <div 
                      key={item.id}
                      onClick={() => {
                        setSelectedApparel(item.id);
                        setCustomImage(null);
                      }}
                      className={`relative rounded-xl border p-2 flex items-center gap-2.5 cursor-pointer transition ${
                        selectedApparel === item.id && !customImage
                          ? 'bg-indigo-950/50 border-indigo-500' 
                          : 'bg-slate-800/40 border-slate-700/60 hover:bg-slate-800'
                      }`}
                    >
                      <img src={item.img} alt={item.title} className="w-10 h-10 rounded-lg object-cover flex-shrink-0" />
                      <div className="min-w-0">
                        <p className="text-xs font-semibold text-slate-200 truncate">{item.title}</p>
                        <p className="text-[10px] text-slate-400 truncate">{item.subtitle}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Step 2: Choose AI Model */}
              <div className="bg-slate-900 rounded-2xl border border-slate-800 p-5 mb-6">
                <h2 className="text-sm font-semibold text-slate-200 mb-3 flex items-center gap-2">
                  <span className="w-5 h-5 rounded-full bg-indigo-600 text-white text-xs flex items-center justify-center font-bold">2</span>
                  Pilih Model AI Virtual
                </h2>

                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  {models.map((m) => (
                    <div 
                      key={m.id}
                      onClick={() => setSelectedModel(m.id)}
                      className={`relative rounded-xl border p-3 flex items-center space-x-3 cursor-pointer transition ${
                        selectedModel === m.id 
                          ? 'bg-indigo-950/50 border-indigo-500' 
                          : 'bg-slate-800/40 border-slate-700/60 hover:bg-slate-800'
                      }`}
                    >
                      <img src={m.avatar} alt={m.name} className="w-12 h-12 rounded-lg object-cover" />
                      <div>
                        <h4 className="text-xs font-semibold text-slate-200">{m.name}</h4>
                        <p className="text-[10px] text-slate-400">{m.style}</p>
                      </div>
                      {selectedModel === m.id && (
                        <CheckCircle2 className="w-4 h-4 text-indigo-400 absolute top-2 right-2" />
                      )}
                    </div>
                  ))}
                </div>
              </div>

              {/* Step 3: Generate Button & Progress */}
              <div className="bg-slate-900 rounded-2xl border border-slate-800 p-5 flex flex-col items-center">
                {isGenerating ? (
                  <div className="w-full py-4 text-center">
                    <div className="w-full bg-slate-800 rounded-full h-3 mb-3 overflow-hidden">
                      <div 
                        className="bg-indigo-600 h-full rounded-full transition-all duration-300"
                        style={{ width: `${generationProgress}%` }}
                      ></div>
                    </div>
                    <p className="text-xs text-indigo-400 font-semibold mb-1">{genStepText}</p>
                    <p className="text-[10px] text-slate-500">Memproses pose model & rendering ({generationProgress}%)</p>
                  </div>
                ) : (
                  <button 
                    onClick={handleStartGeneration}
                    className="w-full sm:w-auto px-8 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-semibold text-xs shadow-lg shadow-indigo-600/30 flex items-center justify-center gap-2 transition active:scale-95"
                  >
                    <Sparkles className="w-4 h-4" /> Generasi Video AI Now
                  </button>
                )}
              </div>
            </div>
          )}

          {}
          {activeTab === 'projects' && (
            <div className="flex-1 p-6 overflow-y-auto max-w-5xl mx-auto">
              <div className="flex justify-between items-center mb-6">
                <div>
                  <h1 className="text-xl font-bold text-white">Proyek Video Saya</h1>
                  <p className="text-xs text-slate-400">Daftar video rotasi fashion yang telah berhasil diekspor.</p>
                </div>
                <button 
                  onClick={() => setActiveTab('ai_generator')}
                  className="px-3.5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-medium flex items-center gap-1.5 shadow-md"
                >
                  <Plus className="w-4 h-4" /> Buat Baru
                </button>
              </div>

              <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                {[
                  { title: 'Graphic Tee Showcase', time: '2 jam lalu', duration: '9 Detik', img: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&auto=format&fit=crop&q=80' },
                  { title: 'Denim Jacket Turnaround', time: '1 hari lalu', duration: '15 Detik', img: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&auto=format&fit=crop&q=80' },
                  { title: 'Summer Dress Spin', time: '3 hari lalu', duration: '9 Detik', img: 'https://images.unsplash.com/photo-1567532939604-b6b5b0db2604?w=300&auto=format&fit=crop&q=80' }
                ].map((item, idx) => (
                  <div key={idx} className="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden group hover:border-slate-700 transition shadow-lg">
                    <div className="aspect-[9/16] bg-slate-800 relative">
                      <img src={item.img} alt={item.title} className="w-full h-full object-cover" />
                      <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
                        <button 
                          onClick={() => {
                            setActiveTab('studio');
                            setIsPlaying(true);
                          }}
                          className="p-3 bg-indigo-600/90 rounded-full text-white shadow-xl transform group-hover:scale-110 transition"
                        >
                          <Play className="w-5 h-5 fill-current ml-0.5" />
                        </button>
                      </div>
                    </div>
                    <div className="p-3">
                      <p className="text-xs font-semibold text-slate-200 truncate">{item.title}</p>
                      <p className="text-[10px] text-slate-400 mt-0.5">{item.time} • {item.duration}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>
      </div>

      {}
      {showExportModal && (
        <div className="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-slate-900 rounded-2xl border border-slate-800 max-w-md w-full p-6 shadow-2xl relative">
            <button 
              onClick={() => setShowExportModal(false)}
              className="absolute top-4 right-4 text-slate-400 hover:text-white p-1 rounded-lg bg-slate-800/50"
            >
              <X className="w-5 h-5" />
            </button>

            <h3 className="text-lg font-bold text-white mb-1 flex items-center gap-2">
              <Download className="w-5 h-5 text-indigo-400" /> Ekspor Video Fashion
            </h3>
            <p className="text-xs text-slate-400 mb-5">Pilih format rasio dan resolusi untuk diunduh ke ponsel Anda.</p>

            <div className="space-y-4">
              <div>
                <label className="text-xs font-medium text-slate-300 block mb-2">Format Video</label>
                <div className="grid grid-cols-2 gap-2">
                  {[
                    { format: '9:16', desc: 'TikTok / Reels / Shorts' },
                    { format: '1:1', desc: 'Feed Instagram' }
                  ].map((f) => (
                    <button
                      key={f.format}
                      onClick={() => setExportFormat(f.format)}
                      className={`p-2.5 rounded-xl border text-left transition ${
                        exportFormat === f.format 
                          ? 'bg-indigo-950/60 border-indigo-500 text-white' 
                          : 'bg-slate-800/40 border-slate-700/60 text-slate-300'
                      }`}
                    >
                      <p className="text-xs font-bold">{f.format}</p>
                      <p className="text-[10px] text-slate-400">{f.desc}</p>
                    </button>
                  ))}
                </div>
              </div>

              <div>
                <label className="text-xs font-medium text-slate-300 block mb-2">Kualitas Video</label>
                <div className="grid grid-cols-2 gap-2">
                  {['1080p Full HD', '4K Ultra HD'].map((q) => (
                    <button
                      key={q}
                      onClick={() => setExportQuality(q)}
                      className={`p-2.5 rounded-xl border text-left transition ${
                        exportQuality === q 
                          ? 'bg-indigo-950/60 border-indigo-500 text-white' 
                          : 'bg-slate-800/40 border-slate-700/60 text-slate-300'
                      }`}
                    >
                      <p className="text-xs font-semibold">{q}</p>
                    </button>
                  ))}
                </div>
              </div>
            </div>

            <div className="mt-6 flex gap-3">
              <button 
                onClick={() => {
                  setShowExportModal(false);
                  alert(`Video (${exportFormat}, ${exportQuality}) berhasil disimpan ke Galeri Ponsel!`);
                }}
                className="flex-1 py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-semibold shadow-lg shadow-indigo-600/30 flex items-center justify-center gap-2 transition"
              >
                <Download className="w-4 h-4" /> Simpan ke Galeri (MP4)
              </button>
            </div>
          </div>
        </div>
      )}

    </div>
  );
}
